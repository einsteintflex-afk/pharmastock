# STAGING environment (same stack, separate host and database) for docker compose. Copy to .env.staging (never
# commit it), replace every "change-me" value, then:
#   docker compose --env-file .env.staging up -d --build
APP_ENV_FILE=.env.staging
PHARMASTOCK_VERSION=2.0.0

# Public host name: Caddy obtains the HTTPS certificate for it automatically.
DOMAIN=staging.pharmastock.example.com
APP_BASE_URL=https://staging.pharmastock.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Database roles (created on first start by deploy/postgres-init.sh)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-long-random
# Schema owner, used only to apply migrations.
OWNER_DB_PASSWORD=change-me-long-random
# Restricted application role (row privileges only).
APP_DB_PASSWORD=change-me-long-random
BACKUP_DB_PASSWORD=change-me-long-random

# Application
PHARMASTOCK_ENV=production
COOKIE_SECURE=true
LOG_FORMAT=json
LOG_LEVEL=INFO
SESSION_HOURS=12
# Encrypts stored secrets (two-step verification keys, provider credentials).
# 48+ random characters; keep it safe: changing it makes stored secrets unreadable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random-at-least-32-characters
# Platform (MedCart Tech) administrators: shorter sessions, step-up window.
PLATFORM_SESSION_HOURS=4
STEP_UP_MINUTES=10
# First administrator (created only when no user exists; must change password).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-Temp-2026

# Optional integrations
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PharmaStock <alerts@example.com>
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# WhatsApp Business Platform (official Cloud API) for platform-provided messaging.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RECEIPT_TEMPLATE=pharmastock_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en
# Payments: manual (confirmed by MedCart Tech) or paystack (verified webhooks).
PAYMENT_PROVIDER=manual
PAYSTACK_SECRET_KEY=
ERROR_WEBHOOK_URL=
METRICS_TOKEN=change-me-random

# Backups (written to ./backups on the host; copy them off the server too)
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24
