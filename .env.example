# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pharmastock

# development | production  (production: secure cookies, HSTS, no /docs)
PHARMASTOCK_ENV=development

# First administrator, created at startup ONLY if no user exists yet.
# Must be changed at first sign-in. Remove these lines afterwards.
# (Alternative: python -m backend.manage create-admin)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Sessions and sign-in protection
SESSION_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# COOKIE_SECURE=true   (default: true in production; requires HTTPS)

# Optional: AI assistant uses Claude when a key is set; otherwise the
# built-in engine answers from the same data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Operations
NOTIFICATION_REFRESH_MINUTES=15
DB_POOL_MIN=1
DB_POOL_MAX=10
LOG_LEVEL=INFO

# Public address of the application (used in links inside e-mails)
APP_BASE_URL=https://pharmastock.example.com

# Outgoing e-mail for notifications and scheduled reports (optional).
# Leave SMTP_HOST empty to disable e-mail delivery (messages are marked SKIPPED).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PharmaStock <alerts@example.com>

# SMS (optional): none | log | webhook. "webhook" POSTs {"to", "message"} as
# JSON to SMS_WEBHOOK_URL with "Authorization: Bearer SMS_WEBHOOK_TOKEN".
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
DELIVERY_INTERVAL_SECONDS=60
