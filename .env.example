# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (required): the restricted APPLICATION role.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pharmastock
# Least privilege (recommended): migrations run as the schema OWNER, and the
# application role above is granted row privileges only. See deploy/create_app_role.sql.
MIGRATION_DATABASE_URL=
APP_DB_ROLE=

# Encrypts stored secrets (two-step verification keys, provider credentials).
# Required in production (32+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production  (production: secure cookies, HSTS, no /docs)
PHARMASTOCK_ENV=development

# First administrator, created at startup ONLY if no user exists yet.
# Must be changed at first sign-in. Remove these lines afterwards.
# (Alternative: python -m backend.manage create-admin)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Sessions and sign-in protection
SESSION_HOURS=12
# Platform (MedCart Tech) administrators: shorter sessions, step-up window.
PLATFORM_SESSION_HOURS=4
STEP_UP_MINUTES=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# COOKIE_SECURE=true   (default: true in production; requires HTTPS)

# Optional: AI assistant uses Claude when a key is set; otherwise the
# built-in engine answers from the same data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Operations
NOTIFICATION_REFRESH_MINUTES=15
DB_POOL_MIN=1
DB_POOL_MAX=10
LOG_LEVEL=INFO

# Public address of the application (used in links inside e-mails)
APP_BASE_URL=https://pharmastock.example.com

# Outgoing e-mail for notifications and scheduled reports (optional).
# Leave SMTP_HOST empty to disable e-mail delivery (messages are marked SKIPPED).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PharmaStock <alerts@example.com>

# SMS (optional): none | log | webhook. "webhook" POSTs {"to", "message"} as
# JSON to SMS_WEBHOOK_URL with "Authorization: Bearer SMS_WEBHOOK_TOKEN".
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
DELIVERY_INTERVAL_SECONDS=60

# WhatsApp Business Platform (official Cloud API), used when an organization
# buys messaging credits from MedCart Tech. Organizations with their own
# WhatsApp Business account enter it in Settings → Messaging instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RECEIPT_TEMPLATE=pharmastock_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en

# Payments for subscriptions and messaging credits: manual | paystack.
# Activation only ever follows a verified provider webhook (or a manual
# confirmation by a platform administrator) — never the browser.
PAYMENT_PROVIDER=manual
PAYSTACK_SECRET_KEY=

# Observability: text | json logs; unhandled errors to a webhook (or Sentry
# when sentry-sdk is installed); /metrics requires "Authorization: Bearer METRICS_TOKEN"
LOG_FORMAT=text
ERROR_WEBHOOK_URL=
SENTRY_DSN=
METRICS_TOKEN=

# Abuse protection (per process; the reverse proxy adds its own limit)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600
# Other origins allowed to send state-changing requests (comma separated)
ALLOWED_ORIGINS=
